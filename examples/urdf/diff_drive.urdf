<?xml version="1.0"?>
<!-- Differential-drive robot: box chassis, two continuous wheels and a caster ball (second collision
     shape of base_link). Drive it in the editor with W/A/S/D. -->
<robot name="diff_drive">
  <!-- Reference frame on the floor, no geometry: imported as no part at all. -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.08"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="4"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><box size="0.42 0.26 0.1"/></geometry>
      <material name="blue"><color rgba="0.2 0.4 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry><box size="0.42 0.26 0.1"/></geometry>
    </collision>
    <!-- Caster ball under the rear of the chassis. -->
    <collision>
      <origin xyz="-0.15 0 -0.04"/>
      <geometry><sphere radius="0.04"/></geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.08 0.16 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" velocity="20"/>
  </joint>

  <link name="left_wheel">
    <inertial><mass value="0.3"/></inertial>
    <collision>
      <!-- URDF cylinders run along local Z; roll by 90 degrees to lay the wheel along Y. -->
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.08 -0.16 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" velocity="20"/>
  </joint>

  <link name="right_wheel">
    <inertial><mass value="0.3"/></inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
  </link>

  <!-- Sensor frame with mass but no geometry: merged into base_link. -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.12 0 0.12"/>
  </joint>
  <link name="laser">
    <inertial><mass value="0.1"/></inertial>
  </link>

  <gazebo reference="left_wheel"><mu1>1.0</mu1></gazebo>
</robot>
