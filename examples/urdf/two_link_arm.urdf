<?xml version="1.0"?>
<!-- Two-link planar arm with revolute joint limits. Import with "Fix base". -->
<robot name="two_link_arm">
  <link name="base_link">
    <inertial>
      <mass value="5"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.3 0.3 0.1"/></geometry>
    </collision>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="30" velocity="2"/>
  </joint>

  <link name="upper_arm">
    <inertial><mass value="1"/></inertial>
    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry><cylinder radius="0.04" length="0.5"/></geometry>
    </collision>
  </link>

  <!-- The elbow frame is yawed by 90 degrees, so its local Y axis points along the parent's -X. -->
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.5" rpy="0 0 1.5707963267948966"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2" upper="2" effort="15" velocity="2"/>
  </joint>

  <link name="forearm">
    <inertial><mass value="0.5"/></inertial>
    <collision>
      <origin xyz="0 0 0.2"/>
      <geometry><box size="0.06 0.06 0.4"/></geometry>
    </collision>
  </link>

  <!-- Massless tool frame: merged into the forearm. -->
  <joint name="tool_joint" type="fixed">
    <parent link="forearm"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.4"/>
  </joint>
  <link name="tool0"/>
</robot>
