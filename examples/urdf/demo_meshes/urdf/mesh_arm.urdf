<?xml version="1.0"?>
<!-- Mesh demo: package:// paths, a binary STL in millimetres (scaled), an OBJ with quads and hexagons,
     and an ASCII STL referenced by a path relative to this file. Import with "Fix base". -->
<robot name="mesh_arm">
  <link name="base_link">
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://demo_meshes/meshes/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <!-- Imported as the mesh's bounding box. -->
      <geometry>
        <mesh filename="package://demo_meshes/meshes/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="12" velocity="1.5"/>
  </joint>

  <link name="arm_link">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://demo_meshes/meshes/arm.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.2 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.08 0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="tool_mount" type="fixed">
    <parent link="arm_link"/>
    <child link="tool_link"/>
    <origin xyz="0.4 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- No collision: merged into arm_link, its mesh is drawn by the arm's part. -->
  <link name="tool_link">
    <visual>
      <geometry>
        <mesh filename="../meshes/tip_ascii.stl"/>
      </geometry>
    </visual>
  </link>
</robot>
